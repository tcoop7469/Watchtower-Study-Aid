rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }

    function isValidArticleRecord(data) {
      return data.keys().hasAll(['userId', 'title', 'createdAt', 'articleData']) &&
             data.keys().size() <= 6 &&
             data.userId == request.auth.uid &&
             data.title is string &&
             data.title.size() <= 200 &&
             data.createdAt is number &&
             data.articleData is string &&
             data.articleData.size() <= 1048576 && // 1MB max
             (data.keys().hasAny(['date']) ? (data.date is string && data.date.size() <= 50) : true) &&
             (data.keys().hasAny(['coverUrl']) ? (data.coverUrl is string && data.coverUrl.size() <= 2000000) : true); // Support base64 image strings (about 2MB)
    }

    match /articles/{articleId} {
      allow create: if isSignedIn() &&
                    isValidId(articleId) &&
                    isValidArticleRecord(incoming()) &&
                    incoming().createdAt == request.time.toMillis();
      
      allow update: if isSignedIn() &&
                    isValidId(articleId) &&
                    isValidArticleRecord(incoming()) &&
                    incoming().userId == existing().userId && 
                    existing().userId == request.auth.uid &&
                    incoming().createdAt == existing().createdAt &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['title', 'date', 'coverUrl', 'articleData']);
      
      allow delete: if isSignedIn() &&
                    isValidId(articleId) &&
                    existing().userId == request.auth.uid;
      
      allow get: if isSignedIn() &&
                 isValidId(articleId) &&
                 existing().userId == request.auth.uid;
                 
      allow list: if isSignedIn() &&
                  resource.data.userId == request.auth.uid;
    }
  }
}
